# Copie para .env.docker e ajuste. Gere a APP_KEY com:
#   docker compose run --rm --no-deps -e APP_KEY=base64:x app php artisan key:generate --show
APP_NAME="Help Desk Pro"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=troque-esta-senha

# Variáveis lidas pela imagem do MariaDB (devem coincidir com as DB_* acima)
MARIADB_DATABASE=helpdesk
MARIADB_USER=helpdesk
MARIADB_PASSWORD=troque-esta-senha
MARIADB_ROOT_PASSWORD=troque-a-senha-root

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Tempo real do chat (Laravel Reverb, docs/chat/06-tempo-real.md). O navegador usa VITE_REVERB_* do .env.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Endereço que a aplicação usa para publicar eventos; dentro do Docker é o serviço "reverb".
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_PORT=8081
# Endereço do Reverb visto pelo NAVEGADOR (vai para o build do front-end). Em produção: o domínio público,
# a porta 443 e https, com o proxy reverso encaminhando o WebSocket para o serviço reverb.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# Produção: origens permitidas no WebSocket (separadas por vírgula) e cookie de sessão só por HTTPS.
REVERB_ALLOWED_ORIGINS=*
# SESSION_SECURE_COOKIE=true
CHAT_ENABLED=false
